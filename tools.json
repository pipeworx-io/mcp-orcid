  {
    "name": "search",
    "description": "Expanded search (Solr-style query) across the ORCID Registry.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "e.g. \"family-name:Lovelace AND given-names:Ada\""
        },
        "rows": {
          "type": "number",
          "description": "1-1000 (default 25)"
        },
        "start": {
          "type": "number",
          "description": "0-based offset"
        }
